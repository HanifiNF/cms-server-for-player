NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Use a dedicated PostgreSQL account with only the permissions documented in
# README.md. DATABASE_URL takes precedence over the individual PG variables.
# DATABASE_URL=postgresql://wir_realtime:change-me@127.0.0.1:5432/wir_player_cms
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wir_player_cms
PGUSER=wir_realtime
PGPASSWORD=change-me
PGSSLMODE=disable

SOCKET_PATH=/socket.io
CORS_ORIGINS=http://localhost:8080
OUTBOX_CHANNEL=player_realtime_outbox
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_STALE_PROCESSING_MS=60000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
