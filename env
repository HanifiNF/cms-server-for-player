#--------------------------------------------------------------------

# Example Environment Configuration file

#

# This file can be used as a starting point for your own

# custom .env files, and contains most of the possible settings

# available in a default install.

#

# By default, all of the settings are commented out. If you want

# to override the setting, you must un-comment it by removing the '#'

# at the beginning of the line.

#--------------------------------------------------------------------

#--------------------------------------------------------------------

# ENVIRONMENT

#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------

# APP

#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

# If you have trouble with `.`, you could also use `_`.

# app_baseURL = ''

app.indexPage = ''
app.appTimezone = 'UTC'

# app.forceGlobalSecureRequests = false

# app.CSPEnabled = false

#--------------------------------------------------------------------

# DATABASE

#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = wir_player_cms
database.default.username = wir_player_app
database.default.password =
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432
database.default.schema = public

#--------------------------------------------------------------------

# PLAYER DEVICE API

#--------------------------------------------------------------------

# Generate strong, unrelated secrets before exposing the CMS API.

cms.adminApiKey =
cms.enrollmentPepper =
cms.enrollmentTtlMinutes = 15

# LDG v1 media encryption. Generate with:

# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"

ldg.masterKey = 'dbKdjeBoSPlcUufenZfE4TxbzUhHTcVDfBllG8NvfxA='
ldg.chunkSize = 4194304
ldg.licenseHours = 24

# Storage credential encryption. Generate a separate key with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Required in production before creating an FTPS profile.

# storage.credentialsKey =
storage.cacheTtlSeconds = 86400
storage.cacheMaxBytes = 53687091200
cms.offlineAfterSeconds = 30
cms.enablePairingCode = false

auth.operatorSessionMinutes = 30
auth.loginAttemptsPerMinute = 5

#--------------------------------------------------------------------
# REALTIME GATEWAY
#--------------------------------------------------------------------

# The outbox remains durable when this is disabled. Enable this after the
# Node.js realtime-gateway is configured so PostgreSQL can wake it immediately.
realtime.enabled = false
# Public Player-facing URL of the standalone Socket.IO gateway.
# Use HTTPS in production, for example: https://realtime.example.com
realtime.publicUrl = http://localhost:3001
realtime.notificationChannel = player_realtime_outbox

# Optional explicit ffprobe executable used for automatic film duration detection.

# Windows example: media.ffprobePath = 'C:\\Users\\YourName\\scoop\\shims\\ffprobe.exe'

# media.ffprobePath =

